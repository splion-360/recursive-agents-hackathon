# Managed MemMachine Platform
MEMMACHINE_BASE_URL=https://api.memmachine.ai
MEMMACHINE_API_KEY=
MEMMACHINE_PROJECT_ID=recursive-agents-hackathon
MEMMACHINE_ORG_ID=

# Crusoe OpenAI-compatible inference (configured during live integration)
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_API_KEY=
CRUSOE_STUDENT_MODEL=Qwen/Qwen3.8-27B
CRUSOE_REVIEWER_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL
CRUSOE_CONSOLIDATOR_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B
CRUSOE_HSTAR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash


# NemoClaw-managed OpenShell (configured during sandbox integration)
OPENSHELL_SANDBOX_NAME=memory-distill
OPENSHELL_GATEWAY=nemoclaw
